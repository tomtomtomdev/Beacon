<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Beacon scheduler (slice 10). Install + load with:
       cp deploy/com.beacon.scheduler.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.beacon.scheduler.plist
     RunAtLoad + KeepAlive → a reboot relaunches it and the next interval poll runs unattended.
     Tail logs at /tmp/beacon.scheduler.{out,err}.log.

     Paths are absolute because launchd has no working shell: uv from Homebrew, project at
     this machine's checkout. Telegram creds are read from app_settings in beacon.db (Settings
     UI), so no BEACON_TELEGRAM_* env is needed here; db_path defaults to the repo-root
     beacon.db that run.sh serves. Moving the checkout means editing this file. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beacon.scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/tomtomtomtom/Documents/beacon/backend</string>
        <string>python</string>
        <string>-m</string>
        <string>beacon.scheduler</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/tomtomtomtom/Documents/beacon/backend</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/beacon.scheduler.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/beacon.scheduler.err.log</string>
</dict>
</plist>
